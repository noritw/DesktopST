<?xml version="1.0" encoding="utf-8"?>
<!-- 陪伴同行計步小工具。底板由 Provider 畫成 bitmap（RemoteViews 不能 tint 背景）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/walk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/walk_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_walk_widget" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/walk_avatar1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/walk_avatar2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/walk_avatar3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/walk_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/walk_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/walk_widget_label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/walk_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/walk_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/walk_refresh"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:contentDescription="@string/walk_widget_refresh"
            android:gravity="center"
            android:text="↻"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
