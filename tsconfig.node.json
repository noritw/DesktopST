{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["./src/core/*"] },
    "outDir": "out"
  },
  "include": ["tests", "vitest.config.ts", "src/core", "src/main", "src/preload", "electron.vite.config.ts", "capacitor.config.ts", "nutrition/desktop/src/main", "nutrition/desktop/electron-vite.config.ts", "nutrition/mobile/vite.config.ts", "nutrition/mobile/capacitor.config.ts"]
}
