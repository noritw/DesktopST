<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 最小版（約 2x1）——owner 2026-08-22 規格 ①：
  「縮到最小 2x1 時數字應該要能夠完整顯示，此版面隱藏『熱量』『蛋白質』標籤
   以空出位置給數值」。

  所以這個檔案**刻意沒有 widget_kcal_label／widget_protein_label 這兩個 view**
  （不是設成隱藏，是根本不存在）。RemoteViews 對找不到的 id 會安靜略過，
  Provider 不必判斷現在是哪個尺寸。

  一格高只有 60～76dp 可用，扣掉 padding 後兩列數字各約 28dp——
  字級由 `NutritionWidgetProvider.valueTextSizeSp()` 依實際高度算，
  下面的 `textSize` 只是預設值，跑起來一定會被覆寫。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:padding="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_btn_refresh"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_widget_button_refresh"
        android:padding="2dp"
        android:src="@drawable/ic_widget_refresh"
        android:contentDescription="@string/widget_refresh" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_kcal_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/widget_placeholder" />

            <TextView
                android:id="@+id/widget_kcal_suffix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:textColor="@color/widget_text_sub"
                android:textSize="9sp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_protein_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/widget_placeholder" />

            <TextView
                android:id="@+id/widget_protein_suffix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:textColor="@color/widget_text_sub"
                android:textSize="9sp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_btn_edit"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_button_circle"
            android:padding="6dp"
            android:src="@drawable/ic_widget_edit"
            android:contentDescription="@string/widget_action_edit" />

        <ImageView
            android:id="@+id/widget_btn_camera"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_widget_button_circle"
            android:padding="6dp"
            android:src="@drawable/ic_widget_camera"
            android:contentDescription="@string/widget_action_camera" />
    </LinearLayout>

</LinearLayout>
