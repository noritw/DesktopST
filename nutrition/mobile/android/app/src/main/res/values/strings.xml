      有空間時帶單位（`/ 1256kcal`）；窄版只有幾個字寬，用不帶單位的 short 版。
    -->
    <string name="widget_value_suffix_kcal">/ %1$dkcal</string>
    <string name="widget_value_suffix_protein">/ %1$dg</string>
    <string name="widget_value_suffix_kcal_short">/%1$d</string>
