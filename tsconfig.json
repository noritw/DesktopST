{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/renderer/src", "src/core", "src/mobile", "src/shared", "nutrition/desktop/src/renderer/src", "nutrition/mobile/src"],
  // smoketest 是 2026-08-03 的一次性能力探針，不是產品程式碼（見 pre-b3-work-assessment.md §5.1）
  "exclude": ["src/mobile/smoketest"]
}
